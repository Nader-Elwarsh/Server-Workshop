rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function own(cid) {
      return signedIn() && (cid == request.auth.uid
        || (exists(/databases/$(database)/documents/portalLinks/$(request.auth.uid))
            && cid == get(/databases/$(database)/documents/portalLinks/$(request.auth.uid)).data.customerId));
    }

    match /staff/{uid} { allow read: if signedIn() && request.auth.uid == uid; }

    match /portal/{doc} { allow read: if signedIn(); allow write: if isStaff(); }

    match /portalLinks/{uid} {
      allow read, write: if isStaff();
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false;
    }

    match /phoneIndex/{p} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['email','uid']);
      allow update, delete: if isStaff();
    }

    match /customers/{id} {
      allow read, write: if isStaff();
      allow read: if own(id);
      allow create: if own(id) && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['name','phone','email','mainAddress','extraAddress','portal','createdAt','updatedAt']);
      allow update: if own(id) && resource.data.portal == true && request.resource.data.portal == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','mainAddress','extraAddress','updatedAt']);
    }
    match /devices/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['customerId','addressKey','type','category','brand','model','desc','photo','portal','createdAt','updatedAt']);
      allow update: if own(resource.data.customerId) && own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['customerId','addressKey','type','category','brand','model','desc','photo','portal','createdAt','updatedAt']);
    }
    match /portalRequests/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.handled == false && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['customerId','deviceId','fault','visit','executionPlace','note','handled','portal','createdAt']);
    }
    match /portalOrders/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
    }
    match /portalComplaints/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.status == 'جديد' && request.resource.data.portal == true
        && own(get(/databases/$(database)/documents/portalOrders/$(request.resource.data.orderId)).data.customerId)
        && get(/databases/$(database)/documents/portalOrders/$(request.resource.data.orderId)).data.status == 'مكتمل'
        && request.resource.data.keys().hasOnly(['customerId','orderId','orderNo','text','status','reply','portal','createdAt']);
    }
    match /portalQuestions/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.status == 'جديد'
        && request.resource.data.published == false
        && request.resource.data.answer == ''
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.keys().hasOnly(['customerId','customerName','deviceId','deviceLabel','text','status','answer','published','postId','portal','createdAt']);
    }
    match /portalSuggestions/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.by);
      allow create: if own(request.resource.data.by) && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['kind','value','parent','by','status','createdAt']);
    }
    match /portalPosts/{id} {
      allow read: if resource.data.published == true;
      allow read, write: if isStaff();
    }
    match /{document=**} { allow read, write: if isStaff(); }
  }
}
