rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // وجود مستند العضوية هو مصدر التفويض الوحيد؛ لا تمنح القواعد أي عميل حق إنشاء هذا المستند.
    // مستند الموظف الموقوف (disabled == true) لا يمنح أي صلاحية؛ والإيقاف نفسه بتكتبه دالة المالك فقط.
    function anyStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    // نطاق الموظف: 'a' = «أوامره المعيّنة فقط» (فني). القيمة بتتكتب في مستند الموظف من دالة السيرفر (staff-admin)
    // وبتتقدّم على claim الـ token (عشان التغيير يسري فورًا مش بعد ساعة). مستند قديم من غير الحقل = نطاق كامل.
    function scopeOfStaff() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data
        .get('sc', request.auth.token.get('sc', 'w'));
    }
    function scopedStaff() { return anyStaff() && scopeOfStaff() == 'a'; }

    // isStaff = موظف بنطاق كامل. كل القواعد القديمة تحت بتستخدمه، فالموظف المحدود النطاق ما بياخدش منها حاجة.
    function isStaff() { return anyStaff() && scopeOfStaff() != 'a'; }

    // الفني يقدر يعدّل أي حاجة في أمره المعيّن له ما عدا: الهوية (رقم الأمر/العميل/الجهاز/تاريخ الإنشاء/المصدر)،
    // التعيين (الفني/محفظته/من عيّنه)، والعربون وبيانات البوابة. (قايمة منع مش قايمة سماح: عشان أي حقل جديد يضيفه التطبيق لشغل الأمر ما يتوقفش.)
    // لوكيشن: إحداثيات (lat/lng أرقام) أو لينك خرائط قصير.
    function locOk(l) {
      return l is map && l.keys().hasOnly(['lat', 'lng', 'acc', 'at', 'url'])
        && (!('lat' in l) || (l.lat is number && l.lat >= -90 && l.lat <= 90))
        && (!('lng' in l) || (l.lng is number && l.lng >= -180 && l.lng <= 180))
        && (!('url' in l) || (l.url is string && l.url.size() <= 300 && l.url.matches('^https://.*')));
    }

    function techOrderPatch() {
      return resource.data.techId == request.auth.uid
        && resource.data.get('closed', false) != true
        && request.resource.data.techId == resource.data.techId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'techId', 'techName', 'techWallet', 'assignedAt', 'assignedBy',
          'customerId', 'deviceId', 'addressKey', 'no', 'createdAt', 'source', 'portalRequestId', 'portalVis', 'portal',
          'deposit', 'depositWallet', 'depositExtra',
          'closed', 'paid', 'paidAt', 'closedAt', 'closeWallet', 'closedByTech',
          'jobType', 'jobTypeName', 'techPay', 'techPayManual', 'techPayAt', 'techPayBy', 'payShares', 'payShareUids', 'returnPayPending'
        ])
        // الإلغاء للإدارة بس. القفل والتحصيل بيتعملوا من السيرفر (دالة techCloseOrder) عشان الأمر وحركة المحفظة يتسجلوا مع بعض.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status != 'ملغي');
    }

    function linkRef() {
      return /databases/$(database)/documents/portalLinks/$(request.auth.uid);
    }

    // الحساب المرتبط يعتمد على portalLinks فقط. الرابط المعطل (بعد استعادة كلمة السر)
    // لا يستطيع الرجوع إلى سجل customers/{uid} القديم لمجرد أن المعرّف يساوي UID.
    function own(customerId) {
      return signedIn() && (
        exists(linkRef())
          ? (get(linkRef()).data.get('disabled', false) != true
              && get(linkRef()).data.customerId == customerId)
          : customerId == request.auth.uid
      );
    }

    function ownsDevice(customerId, deviceId) {
      return deviceId == '' || (
        deviceId is string
        && exists(/databases/$(database)/documents/devices/$(deviceId))
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.customerId == customerId
        && own(customerId)
      );
    }

    function orderRef(orderId) {
      return /databases/$(database)/documents/portalOrders/$(orderId);
    }

    function completedOrderForCustomer(customerId, orderId) {
      return orderId is string
        && exists(orderRef(orderId))
        && get(orderRef(orderId)).data.customerId == customerId
        && get(orderRef(orderId)).data.status == 'مكتمل'
        && own(customerId);
    }

    // العضوية تُدار من بيئة موثوقة (Firebase Console/Admin SDK)، لا من عميل ولا من موظف عادي.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // إعداد الأدوار وسجل المراجعة: القراءة للموظفين (السجل للمالك فقط)، والكتابة من دوال السيرفر فقط.
    match /accessConfig/{doc} {
      allow read: if anyStaff();
    }
    match /staffAudit/{doc} {
      allow read: if isStaff() && request.auth.token.get('role', 'owner') == 'owner';
    }

    match /portal/{doc} {
      // portal/branding = هوية النظام (الاسم والألوان والشعار) وبتتقرأ قبل تسجيل الدخول؛ مفيش فيها بيانات خاصة.
      allow read: if signedIn() || doc == 'branding';
      allow write: if isStaff();
    }

    match /portalLinks/{uid} {
      allow read, write: if isStaff();
      allow read: if signedIn() && request.auth.uid == uid;
      // العميل يستطيع فقط إنهاء تغيير كلمة المرور الإجباري، ولا يغيّر هوية الربط أو تعطيله.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false;
    }

    match /phoneIndex/{phone} {
      // المرحلة 1 (آمنة النشر دلوقتي): القراءة المباشرة لسه مفتوحة عشان نسخ المتصفح القديمة
      // تفضل شغالة لحد ما دوال portalLoginLookup / portalPhoneAvailable تتنشر والواجهة تتحدّث.
      // بعدها انشر firestore.rules.proposed (المرحلة 2) اللي بتقفل get للموظفين وصاحب الحساب بس.
      allow get: if true;
      allow list: if false;
      // الإنشاء: مفتاح المستند لازم يكون رقم موبايل مصري صحيح، والإيميل المسجّل لازم يكون
      // إيميل حساب المستخدم نفسه (يمنع توجيه رقم لإيميل شخص تاني أو مفاتيح عشوائية).
      allow create: if signedIn()
        && phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && 'email' in request.auth.token
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update, delete: if isStaff();
    }

    match /customers/{id} {
      allow read, write: if isStaff();
      allow read: if own(id);
      allow create: if own(id) && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'mainAddress', 'extraAddress', 'portal', 'createdAt', 'updatedAt']);
      allow update: if own(id) && resource.data.portal == true && request.resource.data.portal == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'mainAddress', 'extraAddress', 'updatedAt']);
    }

    match /devices/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['customerId', 'addressKey', 'type', 'category', 'brand', 'model', 'desc', 'photo', 'portal', 'createdAt', 'updatedAt']);
      allow update: if own(resource.data.customerId) && own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId', 'addressKey', 'type', 'category', 'brand', 'model', 'desc', 'photo', 'portal', 'createdAt', 'updatedAt']);
    }

    match /portalRequests/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId)
        && request.resource.data.handled == false && request.resource.data.portal == true
        && ownsDevice(request.resource.data.customerId, request.resource.data.get('deviceId', ''))
        && request.resource.data.keys().hasOnly(['customerId', 'deviceId', 'fault', 'visit', 'executionPlace', 'note', 'handled', 'portal', 'createdAt', 'media', 'loc'])
        // صور/فيديو/صوت العطل (لينكات Cloudinary — بتتفحص تاني وقت العرض) ولوكيشن مكان التنفيذ: اختياريين.
        && (!('media' in request.resource.data) || (request.resource.data.media is list && request.resource.data.media.size() <= 6))
        && (!('loc' in request.resource.data) || locOk(request.resource.data.loc));
    }

    match /portalOrders/{id} {
      // نسخة عرض من أمر الشغل؛ العميل قراءة فقط، والتطبيق (عميل الويب) لا ينشئها ولا يغيّرها.
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
    }

    match /portalComplaints/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId)
        && request.resource.data.status == 'جديد' && request.resource.data.portal == true
        && request.resource.data.reply == ''
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 1000
        && completedOrderForCustomer(request.resource.data.customerId, request.resource.data.orderId)
        && request.resource.data.customerId == get(orderRef(request.resource.data.orderId)).data.customerId
        && request.resource.data.orderNo == get(orderRef(request.resource.data.orderId)).data.no
        && request.resource.data.keys().hasOnly(['customerId', 'orderId', 'orderNo', 'text', 'status', 'reply', 'portal', 'createdAt']);
    }

    match /portalQuestions/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.status == 'جديد'
        && request.resource.data.published == false
        && request.resource.data.answer == ''
        && request.resource.data.text is string && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 1500
        && ownsDevice(request.resource.data.customerId, request.resource.data.get('deviceId', ''))
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'deviceId', 'deviceLabel', 'text', 'status', 'answer', 'published', 'postId', 'portal', 'createdAt', 'images'])
        && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 3));
    }

    match /portalSuggestions/{id} {
      allow read, write: if isStaff();
      allow read: if own(resource.data.by);
      allow create: if own(request.resource.data.by) && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['kind', 'value', 'parent', 'by', 'status', 'createdAt']);
    }

    // طلب صيانة سريع من زائر غير مسجّل (بوابة العملاء ← «طلب صيانة سريع»).
    // الزائر يقدر ينشئ مستند بس بحقول محددة وأطوال محدودة، ومفيش له قراءة ولا تعديل ولا حذف.
    // الموظفون وحدهم يقرؤون الطلبات ويحوّلونها لأوامر شغل (من لوحة بوابة العملاء).
    match /guestRequests/{id} {
      allow read, update, delete: if isStaff();
      // رقم الطلب G-XXXXXX هو نفسه معرّف المستند (يتولّد عند الزائر)؛ لو اتكرر الإنشاء بيتحوّل لتعديل ويترفض.
      allow create: if id.matches('^G-[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['ref', 'name', 'phone', 'center', 'village', 'street', 'deviceType', 'fault', 'handled', 'guest', 'createdAt', 'loc'])
        && (!('loc' in request.resource.data) || locOk(request.resource.data.loc))
        && request.resource.data.keys().hasAll(['ref', 'name', 'phone', 'center', 'village', 'street', 'deviceType', 'fault', 'handled', 'guest', 'createdAt'])
        && request.resource.data.ref == id
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{8,15}$')
        && request.resource.data.center is string && request.resource.data.center.size() >= 1 && request.resource.data.center.size() <= 80
        && request.resource.data.village is string && request.resource.data.village.size() <= 80
        && request.resource.data.street is string && request.resource.data.street.size() >= 3 && request.resource.data.street.size() <= 200
        && request.resource.data.deviceType is string && request.resource.data.deviceType.size() <= 60
        && request.resource.data.fault is string && request.resource.data.fault.size() >= 3 && request.resource.data.fault.size() <= 1000
        && request.resource.data.handled == false && request.resource.data.guest == true
        && request.resource.data.createdAt == request.time;
    }

    match /portalPosts/{id} {
      allow read: if resource.data.published == true;
      allow read, write: if isStaff();
    }

    // ---- الموظف المحدود النطاق (فني): يشوف ويعدّل أوامره المعيّنة له وهي مفتوحة بس ----
    // الاستعلام لازم يكون: where techId == uid و where closed == false (القواعد مش فلتر).
    match /requests/{id} {
      allow get, list: if scopedStaff() && resource.data.techId == request.auth.uid && resource.data.closed == false;
      allow update: if scopedStaff() && techOrderPatch();
    }

    // نسخة عرض (من أجهزة الإدارة) فيها العميل والجهاز بتوع كل أمر معيّن: الفني يقرأ بتاعته بس ويمسحها لما يقفل الأمر.
    match /techOrders/{id} {
      allow get, list: if scopedStaff() && resource.data.techId == request.auth.uid;
      allow delete: if scopedStaff() && resource.data.techId == request.auth.uid;
    }

    // نسخة قديمة من حساب عهدة الفني (قبل دالة techAccount على السيرفر). القراءة بس، ومحدش بيكتبها من الأجهزة دلوقتي.
    match /techWallets/{uid} {
      allow get: if scopedStaff() && uid == request.auth.uid;
    }

    // مصروفات الفني: بينشئها «معلّقة» وبيشوف بتاعته بس وبيلغي المعلّقة منها. الاعتماد/الرفض من أجهزة الإدارة (قاعدة الموظف الكامل).
    match /techExpenses/{id} {
      allow get, list: if scopedStaff() && resource.data.techId == request.auth.uid;
      allow create: if scopedStaff()
        && request.resource.data.techId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['techId', 'techName', 'wallet', 'amount', 'note', 'category', 'orderId', 'orderNo', 'status', 'at', 'pay'])
        && (!('pay' in request.resource.data) || request.resource.data.pay in ['custody', 'own', 'workshop'])
        && request.resource.data.keys().hasAll(['techId', 'amount', 'note', 'status', 'at'])
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.note is string && request.resource.data.note.size() >= 2 && request.resource.data.note.size() <= 300;
      allow delete: if scopedStaff() && resource.data.techId == request.auth.uid && resource.data.status == 'pending';
    }

    // الإعدادات: المحدود يقرأ الإعدادات العامة وعلامة التحديث بس (مفيش أي wfkv_* = مصروفات/سلة/…)، ويكتب علامة التحديث.
    match /settings/{doc} {
      allow get: if scopedStaff() && (doc == 'global' || doc == 'wf_meta');
      allow create, update: if scopedStaff() && doc == 'wf_meta'
        && request.resource.data.keys().hasOnly(['ts', 'dev']);
    }

    // ---- الإشعارات الداخلية: صندوق لكل مستخدم (موظف أو عميل). الإشعارات بتتكتب من السيرفر بس (دوال notify*). ----
    // صاحب الصندوق يقرأ ويعلّم «مقروء» ويمسح. الإعلانات العامة للعملاء في inbox/_customers (قراءة لأي حد مسجّل).
    match /inbox/{uid}/items/{id} {
      allow read: if signedIn() && (request.auth.uid == uid || uid == '_customers');
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // إعدادات الإشعارات (الأنواع المكتومة) — كل واحد بتاعه بس.
    match /notifPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mute', 'at'])
        && request.resource.data.mute is list && request.resource.data.mute.size() <= 60;
    }
    // تحكم المالك في الإشعارات للنظام كله (أنواع مقفولة + مواعيد التذكيرات). أي حد مسجّل يقرأ، والمالك بس يكتب.
    match /notifConfig/{doc} {
      allow read: if signedIn();
      allow write: if isStaff() && request.auth.token.get('role', 'owner') == 'owner' && doc == 'global'
        && request.resource.data.keys().hasOnly(['off', 'remindMin', 'overdueHours', 'digestHour', 'custodyMax', 'feedbackDays', 'warrantyDays', 'at', 'by'])
        && request.resource.data.off is list && request.resource.data.off.size() <= 80;
    }
    // اشتراكات الإشعارات (pushSubs) ومفاتيحها (serverConfig): السيرفر بس، مفيش أي قراءة أو كتابة من المتصفح.

    // قواعد الموظفين الشاملة لباقي بيانات التطبيق لا تشمل staff؛ يمنع ذلك أي موظف من
    // تصعيد صلاحياته أو إضافة موظف آخر عبر القاعدة العامة.
    match /{collection}/{document=**} {
      allow read, write: if isStaff() && collection != 'staff' && collection != 'accessConfig' && collection != 'staffAudit'
        && collection != 'inbox' && collection != 'notifPrefs' && collection != 'pushSubs' && collection != 'serverConfig' && collection != 'notifConfig' && collection != 'mediaFiles' && collection != 'rateLimits';
    }
  }
}
