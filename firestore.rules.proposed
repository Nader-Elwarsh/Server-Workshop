rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // وجود مستند العضوية هو مصدر التفويض الوحيد؛ لا تمنح القواعد أي عميل حق إنشاء هذا المستند.
    // مستند الموظف الموقوف (disabled == true) لا يمنح أي صلاحية؛ والإيقاف نفسه بتكتبه دالة المالك فقط.
    function anyStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    // نطاق الموظف: 'a' = «أوامره المعيّنة فقط» (فني). القيمة بتتكتب في مستند الموظف من دالة السيرفر (staff-admin)
    // وبتتقدّم على claim الـ token (عشان التغيير يسري فورًا مش بعد ساعة). مستند قديم من غير الحقل = نطاق كامل.
    function scopeOfStaff() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data
        .get('sc', request.auth.token.get('sc', 'w'));
    }
    function scopedStaff() { return anyStaff() && scopeOfStaff() == 'a'; }

    // isStaff = موظف بنطاق كامل. كل القواعد القديمة تحت بتستخدمه، فالموظف المحدود النطاق ما بياخدش منها حاجة.
    function isStaff() { return anyStaff() && scopeOfStaff() != 'a'; }

    // ---- الصلاحيات من السيرفر (المرحلة 2): مستند الموظف فيه own (مالك) و p (خريطة صلاحياته الفعلية) — بتكتبهم دالة staffSync/الأدوار بس ----
    // مستند قديم من غير own: نفس منطق roles-core (مش «مُدار» أو من غير دور أو دوره owner = مالك).
    function me() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function ownerS() {
      return me().get('own', !(me().get('acl', 0) == 1 || me().get('createdBy', '') != '') || me().get('role', '') == '' || me().get('role', '') == 'owner') == true;
    }
    function can(ks) { return ownerS() || me().get('p', {}).keys().hasAny(ks); }
    // اللي بيمسح سجل لازم يكون ليه صلاحية مسح القسم ده (شاهد الحذف بيخلّي الأجهزة التانية تشيله)
    function canDelCol(c) {
      return (c == 'customers' && can(['customers.delete', 'customers.merge', 'data.wipe']))
        || (c == 'devices' && can(['devices.delete', 'customers.merge', 'data.wipe']))
        || (c == 'requests' && can(['requests.delete', 'data.wipe']))
        || (c == 'parts' && can(['inventory.delete', 'data.wipe']))
        || (c == 'partMoves' && can(['inventory.delete', 'requests.delete', 'data.wipe']))
        || (c == 'treasury' && can(['treasury.delete', 'data.wipe']))
        || (c == 'tasks' && can(['tasks.delete', 'data.wipe']))
        || (c == 'walletTx' && can(['wallets.delete', 'requests.delete', 'data.wipe']))
        || (c == 'faultCodes' && can(['faultcodes.delete', 'data.wipe']))
        || (c == 'invoices' && can(['invoices.delete', 'data.wipe']));
    }
    // حركة محفظة من غير صلاحية المحافظ: مسموحة بس لو جاية من شغلانة الموظف نفسه (عربون/تحصيل أمر، توريد، عهدة، أجور)
    function txSrcOk(d) {
      return (can(['requests.add', 'requests.edit', 'requests.close', 'requests.delete']) && d.get('source', '') in ['order-link', 'order-part', 'ext-part', 'admin-part'])
        || (can(['inventory.add', 'inventory.edit']) && d.get('source', '') in ['restock', 'part-sale'])
        || (can(['custody.approve', 'custody.settle']) && d.get('source', '') in ['custody', 'custody-expense'])
        || (can(['techpay.manage']) && d.get('source', '') == 'techpay');
    }

    // الفني يقدر يعدّل أي حاجة في أمره المعيّن له ما عدا: الهوية (رقم الأمر/العميل/الجهاز/تاريخ الإنشاء/المصدر)،
    // التعيين (الفني/محفظته/من عيّنه)، والعربون وبيانات البوابة. (قايمة منع مش قايمة سماح: عشان أي حقل جديد يضيفه التطبيق لشغل الأمر ما يتوقفش.)
    // لوكيشن: إحداثيات (lat/lng أرقام) أو لينك خرائط قصير.
    function locOk(l) {
      return l is map && l.keys().hasOnly(['lat', 'lng', 'acc', 'at', 'url'])
        && (!('lat' in l) || (l.lat is number && l.lat >= -90 && l.lat <= 90))
        && (!('lng' in l) || (l.lng is number && l.lng >= -180 && l.lng <= 180))
        && (!('url' in l) || (l.url is string && l.url.size() <= 300 && l.url.matches('^https://.*')));
    }

    function techOrderPatch() {
      return resource.data.techId == request.auth.uid
        && resource.data.get('closed', false) != true
        && request.resource.data.techId == resource.data.techId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'techId', 'techName', 'techWallet', 'assignedAt', 'assignedBy',
          'customerId', 'deviceId', 'addressKey', 'no', 'createdAt', 'source', 'portalRequestId', 'portalVis', 'portal',
          'deposit', 'depositWallet', 'depositExtra',
          'closed', 'paid', 'paidAt', 'closedAt', 'closeWallet', 'closedByTech',
          'jobType', 'jobTypeName', 'techPay', 'techPayManual', 'techPayAt', 'techPayBy', 'payShares', 'payShareUids', 'returnPayPending',
          // فلوس العربون المرتجع والضمان بتتحدد من الإدارة بس
          'depositRefunded', 'warrantyUntil', 'warrantyDays', 'warrantyManual', 'warrantyDecision', 'warrantyOf', 'warrantyOfNo', 'warrantyOfScope', 'warrantyScope'
        ])
        // الإلغاء للإدارة بس. القفل والتحصيل بيتعملوا من السيرفر (دالة techCloseOrder) عشان الأمر وحركة المحفظة يتسجلوا مع بعض.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status != 'ملغي');
    }

    // 🛡️ بوابة العملاء: المعرّفات اللي بيختارها جهاز العميل حروف/أرقام بس (من غير تنصيص أو <>)، والنصوص بطول محدود
    function safeId(x) { return x is string && x.matches('^[A-Za-z0-9_-]{1,80}$'); }
    function portalText(d, k, n) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n); }

    function linkRef() {
      return /databases/$(database)/documents/portalLinks/$(request.auth.uid);
    }

    // الحساب المرتبط يعتمد على portalLinks فقط. الرابط المعطل (بعد استعادة كلمة السر)
    // لا يستطيع الرجوع إلى سجل customers/{uid} القديم لمجرد أن المعرّف يساوي UID.
    function own(customerId) {
      return signedIn() && (
        exists(linkRef())
          ? (get(linkRef()).data.get('disabled', false) != true
              && get(linkRef()).data.customerId == customerId)
          : customerId == request.auth.uid
      );
    }

    function ownsDevice(customerId, deviceId) {
      return deviceId == '' || (
        deviceId is string
        && exists(/databases/$(database)/documents/devices/$(deviceId))
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.customerId == customerId
        && own(customerId)
      );
    }

    function orderRef(orderId) {
      return /databases/$(database)/documents/portalOrders/$(orderId);
    }

    function completedOrderForCustomer(customerId, orderId) {
      return orderId is string
        && exists(orderRef(orderId))
        && get(orderRef(orderId)).data.customerId == customerId
        && get(orderRef(orderId)).data.status == 'مكتمل'
        && own(customerId);
    }

    // العضوية تُدار من بيئة موثوقة (Firebase Console/Admin SDK)، لا من عميل ولا من موظف عادي.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // إعداد الأدوار وسجل المراجعة: القراءة للموظفين (السجل للمالك فقط)، والكتابة من دوال السيرفر فقط.
    match /accessConfig/{doc} {
      allow read: if anyStaff();
    }
    match /staffAudit/{doc} {
      allow read: if isStaff() && ownerS();
    }

    match /portal/{doc} {
      // portal/branding = هوية النظام (الاسم والألوان والشعار) وبتتقرأ قبل تسجيل الدخول؛ مفيش فيها بيانات خاصة.
      allow read: if signedIn() || doc == 'branding';
      allow write: if isStaff() && can(['portal.manage', 'branding.manage', 'settings.edit']);
    }

    match /portalLinks/{uid} {
      allow read: if isStaff() && can(['portal.manage', 'customers.merge', 'customers.edit']);
      // الكتابة (إنشاء رابط/تفعيل/تعطيل) لمن يدير البوابة أو يدمج العملاء بس — «تعديل عميل» لوحدها ما تكفيش:
      // وإلا موظف بيعدّل بيانات العملاء يقدر يربط حسابه بأي عميل أو يفعّل رابط معلّق للتحقق (pendingVerify).
      allow write: if isStaff() && can(['portal.manage', 'customers.merge']);
      allow read: if signedIn() && request.auth.uid == uid;
      // العميل يستطيع فقط إنهاء تغيير كلمة المرور الإجباري، ولا يغيّر هوية الربط أو تعطيله.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false;
    }

    match /phoneIndex/{phone} {
      // المرحلة 2: ما ينفعش تنشر الملف ده إلا بعد نشر دوال portalLoginLookup / portalPhoneAvailable
      // وتحديث الواجهة (portal.html + app-check.js). القراءة بقت للموظفين وصاحب الحساب بس؛
      // أي حد تاني بيستخدم الدالة (محدودة العدد ومحمية بـ App Check).
      allow get: if (isStaff() && can(['portal.manage', 'customers.merge', 'customers.edit', 'customers.view'])) || (signedIn() && resource != null && resource.data.uid == request.auth.uid);
      allow list: if false;
      // الإنشاء: مفتاح المستند لازم يكون رقم موبايل مصري صحيح، والإيميل المسجّل لازم يكون
      // إيميل حساب المستخدم نفسه (يمنع توجيه رقم لإيميل شخص تاني أو مفاتيح عشوائية).
      allow create: if signedIn()
        && phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && 'email' in request.auth.token
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update, delete: if isStaff() && can(['portal.manage', 'customers.merge']);
    }

    match /customers/{id} {
      allow read: if isStaff() && can(['customers.view', 'customers.merge', 'requests.view', 'devices.view', 'route.view', 'followup.view', 'warranty.view', 'portal.manage', 'requests.assign']);
      allow create: if isStaff() && can(['customers.add', 'customers.merge', 'requests.add', 'portal.manage']);
      allow update: if isStaff() && can(['customers.edit', 'customers.merge', 'requests.add', 'requests.edit', 'portal.manage']);
      allow delete: if isStaff() && can(['customers.delete', 'customers.merge', 'data.wipe']);
      allow read: if own(id);
      allow create: if own(id) && request.resource.data.portal == true
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'mainAddress', 'extraAddress', 'portal', 'createdAt', 'updatedAt'])
        && portalText(request.resource.data, 'name', 80) && portalText(request.resource.data, 'phone', 20) && portalText(request.resource.data, 'email', 120);
      allow update: if own(id) && resource.data.portal == true && request.resource.data.portal == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'mainAddress', 'extraAddress', 'updatedAt']);
    }

    match /devices/{id} {
      allow read: if isStaff() && can(['devices.view', 'customers.view', 'customers.merge', 'requests.view', 'route.view', 'followup.view', 'warranty.view', 'portal.manage', 'requests.assign']);
      allow create: if isStaff() && can(['devices.add', 'requests.add', 'portal.manage', 'customers.merge']);
      allow update: if isStaff() && can(['devices.edit', 'devices.add', 'customers.merge', 'requests.add', 'requests.edit', 'portal.manage']);
      allow delete: if isStaff() && can(['devices.delete', 'customers.merge', 'data.wipe']);
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.portal == true && safeId(id)
        && request.resource.data.keys().hasOnly(['customerId', 'addressKey', 'type', 'category', 'brand', 'model', 'desc', 'photo', 'portal', 'createdAt', 'updatedAt'])
        && portalText(request.resource.data, 'model', 120) && portalText(request.resource.data, 'desc', 500);
      allow update: if own(resource.data.customerId) && own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId', 'addressKey', 'type', 'category', 'brand', 'model', 'desc', 'photo', 'portal', 'createdAt', 'updatedAt']);
    }

    match /portalRequests/{id} {
      allow read, write: if isStaff() && can(['portal.manage', 'requests.add', 'customers.merge']);
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && safeId(id)
        && request.resource.data.handled == false && request.resource.data.portal == true
        && portalText(request.resource.data, 'fault', 1000) && portalText(request.resource.data, 'note', 1000) && portalText(request.resource.data, 'executionPlace', 60)
        && (!('visit' in request.resource.data) || request.resource.data.visit == null || (request.resource.data.visit is string && request.resource.data.visit.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)?$')))
        && ownsDevice(request.resource.data.customerId, request.resource.data.get('deviceId', ''))
        && request.resource.data.keys().hasOnly(['customerId', 'deviceId', 'fault', 'visit', 'executionPlace', 'note', 'handled', 'portal', 'createdAt', 'media', 'loc'])
        // صور/فيديو/صوت العطل (لينكات Cloudinary — بتتفحص تاني وقت العرض) ولوكيشن مكان التنفيذ: اختياريين.
        && (!('media' in request.resource.data) || (request.resource.data.media is list && request.resource.data.media.size() <= 6))
        && (!('loc' in request.resource.data) || locOk(request.resource.data.loc));
    }

    match /portalOrders/{id} {
      // نسخة عرض من أمر الشغل؛ العميل قراءة فقط، والتطبيق (عميل الويب) لا ينشئها ولا يغيّرها.
      allow read, write: if isStaff() && can(['portal.manage', 'requests.add', 'requests.edit', 'requests.close', 'customers.merge']);
      allow read: if own(resource.data.customerId);
    }

    match /portalComplaints/{id} {
      allow read, write: if isStaff() && can(['portal.manage', 'customers.merge']);
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId)
        && request.resource.data.status == 'جديد' && request.resource.data.portal == true
        && request.resource.data.reply == ''
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 1000
        && completedOrderForCustomer(request.resource.data.customerId, request.resource.data.orderId)
        && request.resource.data.customerId == get(orderRef(request.resource.data.orderId)).data.customerId
        && request.resource.data.orderNo == get(orderRef(request.resource.data.orderId)).data.no
        && request.resource.data.keys().hasOnly(['customerId', 'orderId', 'orderNo', 'text', 'status', 'reply', 'portal', 'createdAt']);
    }

    match /portalQuestions/{id} {
      allow read, write: if isStaff() && can(['portal.manage', 'customers.merge']);
      allow read: if own(resource.data.customerId);
      allow create: if own(request.resource.data.customerId) && request.resource.data.portal == true
        && request.resource.data.status == 'جديد'
        && request.resource.data.published == false
        && request.resource.data.answer == ''
        && request.resource.data.text is string && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 1500
        && ownsDevice(request.resource.data.customerId, request.resource.data.get('deviceId', ''))
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'deviceId', 'deviceLabel', 'text', 'status', 'answer', 'published', 'postId', 'portal', 'createdAt', 'images'])
        && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 3));
    }

    match /portalSuggestions/{id} {
      allow read, write: if isStaff() && can(['portal.manage', 'customers.merge']);
      allow read: if own(resource.data.by);
      allow create: if own(request.resource.data.by) && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['kind', 'value', 'parent', 'by', 'status', 'createdAt']);
    }

    // طلب صيانة سريع من زائر غير مسجّل (بوابة العملاء ← «طلب صيانة سريع»).
    // الزائر يقدر ينشئ مستند بس بحقول محددة وأطوال محدودة، ومفيش له قراءة ولا تعديل ولا حذف.
    // الموظفون وحدهم يقرؤون الطلبات ويحوّلونها لأوامر شغل (من لوحة بوابة العملاء).
    match /guestRequests/{id} {
      allow read, update, delete: if isStaff() && can(['portal.manage', 'requests.add']);
      // الزائر بيبعت الطلب عن طريق دالة السيرفر portalGuestRequest (محدودة العدد لكل IP ولكل رقم) — مفيش كتابة مباشرة.
      allow create: if false;
    }

    match /portalPosts/{id} {
      allow read: if resource.data.published == true;
      allow read, write: if isStaff() && can(['portal.manage']);
    }

    // ---- الموظف المحدود النطاق (فني): يشوف ويعدّل أوامره المعيّنة له وهي مفتوحة بس ----
    // الاستعلام لازم يكون: where techId == uid و where closed == false (القواعد مش فلتر).
    match /requests/{id} {
      allow get, list: if scopedStaff() && resource.data.techId == request.auth.uid && resource.data.closed == false;
      allow update: if scopedStaff() && techOrderPatch();
      allow read: if isStaff() && can(['requests.view', 'route.view', 'followup.view', 'warranty.view', 'requests.assign', 'custody.approve', 'custody.settle', 'reports.view', 'portal.manage']);
      allow create: if isStaff() && can(['requests.add', 'portal.manage']);
      allow update: if isStaff() && can(['requests.add', 'requests.edit', 'requests.close', 'requests.assign', 'portal.manage', 'techpay.manage', 'custody.approve', 'custody.settle', 'customers.merge']);
      allow delete: if isStaff() && can(['requests.delete', 'data.wipe']);
    }

    // نسخة عرض (من أجهزة الإدارة) فيها العميل والجهاز بتوع كل أمر معيّن: الفني يقرأ بتاعته بس ويمسحها لما يقفل الأمر.
    match /techOrders/{id} {
      allow get, list: if scopedStaff() && resource.data.techId == request.auth.uid;
      allow delete: if scopedStaff() && resource.data.techId == request.auth.uid;
      allow read, write: if isStaff() && can(['requests.assign', 'requests.add', 'requests.edit', 'requests.close']);
    }

    // نسخة قديمة من حساب عهدة الفني (قبل دالة techAccount على السيرفر). القراءة بس، ومحدش بيكتبها من الأجهزة دلوقتي.
    match /techWallets/{uid} {
      allow get: if scopedStaff() && uid == request.auth.uid;
      allow read, write: if isStaff() && can(['custody.approve', 'custody.settle']);
    }

    // مصروفات الفني: بينشئها «معلّقة» وبيشوف بتاعته بس وبيلغي المعلّقة منها. الاعتماد/الرفض من أجهزة الإدارة (قاعدة الموظف الكامل).
    match /techExpenses/{id} {
      allow get, list: if scopedStaff() && resource.data.techId == request.auth.uid;
      allow create: if scopedStaff()
        && request.resource.data.techId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['techId', 'techName', 'wallet', 'amount', 'note', 'category', 'orderId', 'orderNo', 'status', 'at', 'pay'])
        && (!('pay' in request.resource.data) || request.resource.data.pay in ['custody', 'own', 'workshop'])
        && request.resource.data.keys().hasAll(['techId', 'amount', 'note', 'status', 'at'])
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.note is string && request.resource.data.note.size() >= 2 && request.resource.data.note.size() <= 300;
      allow delete: if scopedStaff() && resource.data.techId == request.auth.uid && resource.data.status == 'pending';
      allow read, write: if isStaff() && can(['custody.approve', 'custody.settle']);
    }

    // الإعدادات: المحدود يقرأ الإعدادات العامة وعلامة التحديث بس (مفيش أي wfkv_* = مصروفات/سلة/…)، ويكتب علامة التحديث.
    match /settings/{doc} {
      allow get: if scopedStaff() && (doc == 'global' || doc == 'wf_meta');
      allow create, update: if scopedStaff() && doc == 'wf_meta'
        && request.resource.data.keys().hasOnly(['ts', 'dev']);
      // موظف كامل: يقرأ الإعدادات كلها، ويكتب حسب صلاحياته (wfkv_* = قوايم إضافية متقسمة أجزاء ~0 ~1 ...)
      // 🔐 أقل صلاحية: المصروفات (wfkv_wf_e) وأجور الفنيين (wfkv_wf_techpay) لأصحاب صلاحيتها بس.
      // الشرط الأول ما بيعتمدش على اسم المستند، فاستعلام المجموعة كلها (المزامنة) بيفضل شغال للمالك ولمن عنده الصلاحيتين.
      // الباقي بيترفض له الاستعلام الكامل، والمزامنة (readSettingsSnap) بتقرا المستندات المسموحة بالاسم.
      allow read: if isStaff() && (
        (can(['wallets.view', 'wallets.add', 'wallets.edit', 'wallets.delete', 'reports.view']) && can(['techpay.manage', 'reports.view']))
        || (!doc.matches('^wfkv_wf_(e|techpay)(~[0-9]+)?$'))
        || (doc.matches('^wfkv_wf_e(~[0-9]+)?$') && can(['wallets.view', 'wallets.add', 'wallets.edit', 'wallets.delete', 'reports.view']))
        || (doc.matches('^wfkv_wf_techpay(~[0-9]+)?$') && can(['techpay.manage', 'reports.view'])));
      allow write: if isStaff() && (
        doc == 'wf_meta'
        || (doc == 'global' && (can(['settings.edit', 'branding.manage'])
              || (can(['inventory.add', 'inventory.edit']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiInvAliases']))))
        || (doc.matches('^wfkv_wf_e(~[0-9]+)?$') && can(['wallets.add', 'wallets.edit', 'wallets.delete']))
        || doc.matches('^wfkv_wf_trash(~[0-9]+)?$')
        || (doc.matches('^wfkv_wf_followup_log(~[0-9]+)?$') && can(['followup.view', 'requests.add', 'requests.edit']))
        || (doc.matches('^wfkv_wf_pending_calls(~[0-9]+)?$') && can(['requests.add', 'requests.edit']))
        || (doc.matches('^wfkv_wf_comp_(custom|fav)(~[0-9]+)?$') && can(['faultcodes.view', 'faultcodes.add', 'faultcodes.edit']))
        || (doc.matches('^wfkv_wf_techpay(~[0-9]+)?$') && can(['techpay.manage']))
        || can(['settings.edit']));
    }

    // ---- بيانات الورشة: كل قسم بصلاحياته ----
    match /parts/{id} {
      allow read: if isStaff() && can(['inventory.view', 'requests.add', 'requests.edit', 'requests.close', 'reports.view', 'invoices.add']);
      allow create: if isStaff() && can(['inventory.add']);
      allow update: if isStaff() && can(['inventory.add', 'inventory.edit', 'requests.add', 'requests.edit', 'requests.close', 'requests.delete', 'invoices.add']);
      allow delete: if isStaff() && can(['inventory.delete', 'data.wipe']);
    }
    match /partMoves/{id} {
      allow read: if isStaff() && can(['inventory.view', 'requests.add', 'requests.edit', 'requests.close', 'reports.view']);
      allow create: if isStaff() && can(['inventory.add', 'inventory.edit', 'requests.add', 'requests.edit', 'requests.close', 'requests.delete', 'invoices.add']);
      allow update: if isStaff() && can(['inventory.edit']);
      allow delete: if isStaff() && can(['inventory.delete', 'requests.delete', 'data.wipe']);
    }
    match /invoices/{id} {
      allow read: if isStaff() && can(['inventory.view', 'invoices.add', 'invoices.edit', 'invoices.delete', 'reports.view']);
      allow create, update: if isStaff() && can(['invoices.add', 'invoices.edit', 'inventory.add']);
      allow delete: if isStaff() && can(['invoices.delete', 'data.wipe']);
    }
    match /walletTx/{id} {
      allow read: if isStaff() && can(['wallets.view', 'reports.view', 'requests.add', 'requests.edit', 'requests.close', 'custody.approve', 'custody.settle', 'inventory.add', 'inventory.edit', 'techpay.manage']);
      allow create: if isStaff() && (can(['wallets.add']) || txSrcOk(request.resource.data));
      allow update: if isStaff() && (can(['wallets.edit']) || (txSrcOk(request.resource.data) && txSrcOk(resource.data)));
      allow delete: if isStaff() && (can(['wallets.delete', 'data.wipe']) || (can(['requests.delete']) && resource.data.get('source', '') in ['order-link', 'order-part', 'ext-part']));
    }
    match /treasury/{id} {
      allow read: if isStaff() && can(['treasury.view', 'reports.view']);
      allow create: if isStaff() && (can(['treasury.add']) || (can(['wallets.add']) && request.resource.data.get('source', '') == 'transfer'));
      allow update: if isStaff() && can(['treasury.edit']);
      allow delete: if isStaff() && can(['treasury.delete', 'data.wipe']);
    }
    match /tasks/{id} {
      allow read: if isStaff() && can(['tasks.view', 'followup.view']);
      allow create, update: if isStaff() && can(['tasks.add', 'tasks.edit', 'requests.add', 'requests.edit', 'followup.view']);
      allow delete: if isStaff() && can(['tasks.delete', 'data.wipe']);
    }
    match /faultCodes/{id} {
      allow read: if isStaff() && can(['faultcodes.view', 'requests.view']);
      allow create: if isStaff() && can(['faultcodes.add']);
      allow update: if isStaff() && can(['faultcodes.edit']);
      allow delete: if isStaff() && can(['faultcodes.delete', 'data.wipe']);
    }
    // 📦 الأرشيف: السيرفر بس هو اللي بيكتب (الأرشفة الليلية والرجوع بدوال السيرفر). القراءة بنفس صلاحيات القسم الأصلي.
    match /archRequests/{id} {
      allow read: if isStaff() && can(['requests.view', 'customers.view', 'reports.view', 'warranty.view', 'data.backup']);
    }
    match /archWalletTx/{id} {
      allow read: if isStaff() && can(['wallets.view', 'reports.view', 'requests.view', 'data.backup']);
    }
    match /archTreasury/{id} {
      allow read: if isStaff() && can(['treasury.view', 'reports.view', 'data.backup']);
    }
    match /archSum/{id} {
      allow read: if isStaff() && can(['reports.view', 'wallets.view', 'treasury.view']);
    }
    match /archCust/{id} {
      allow read: if isStaff() && can(['customers.view', 'requests.view', 'reports.view']);
    }
    match /archMeta/{id} {
      allow read: if isStaff();
    }
    match /syncDeletes/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && canDelCol(request.resource.data.get('c', ''));
      allow delete: if isStaff() && ownerS();
    }
    match /clientErrors/{id} {
      allow create, update: if isStaff();
      allow read, delete: if isStaff() && ownerS();
    }

    // ---- الإشعارات الداخلية: صندوق لكل مستخدم (موظف أو عميل). الإشعارات بتتكتب من السيرفر بس (دوال notify*). ----
    // صاحب الصندوق يقرأ ويعلّم «مقروء» ويمسح. الإعلانات العامة للعملاء في inbox/_customers (قراءة لأي حد مسجّل).
    match /inbox/{uid}/items/{id} {
      allow read: if signedIn() && (request.auth.uid == uid || uid == '_customers');
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // إعدادات الإشعارات (الأنواع المكتومة) — كل واحد بتاعه بس.
    match /notifPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mute', 'at'])
        && request.resource.data.mute is list && request.resource.data.mute.size() <= 60;
    }
    // تحكم المالك في الإشعارات للنظام كله (أنواع مقفولة + مواعيد التذكيرات). أي حد مسجّل يقرأ، والمالك بس يكتب.
    match /notifConfig/{doc} {
      allow read: if signedIn();
      allow write: if isStaff() && ownerS() && doc == 'global'
        && request.resource.data.keys().hasOnly(['off', 'remindMin', 'overdueHours', 'digestHour', 'custodyMax', 'feedbackDays', 'warrantyDays', 'at', 'by'])
        && request.resource.data.off is list && request.resource.data.off.size() <= 80;
    }
    // اشتراكات الإشعارات (pushSubs) ومفاتيحها (serverConfig): السيرفر بس، مفيش أي قراءة أو كتابة من المتصفح.

    // قواعد الموظفين الشاملة لباقي بيانات التطبيق لا تشمل staff؛ يمنع ذلك أي موظف من
    // تصعيد صلاحياته أو إضافة موظف آخر عبر القاعدة العامة.
    match /{collection}/{document=**} {
      // أي مجموعة تانية (قديمة/مستقبلية) للمالك بس — الموظف بياخد اللي صلاحياته بتسمح بيه من القواعد اللي فوق.
      allow read, write: if isStaff() && ownerS() && collection != 'staff' && collection != 'accessConfig' && collection != 'staffAudit'
        && collection != 'inbox' && collection != 'notifPrefs' && collection != 'pushSubs' && collection != 'serverConfig' && collection != 'notifConfig' && collection != 'mediaFiles' && collection != 'rateLimits'
        && !(collection in ['archRequests', 'archWalletTx', 'archTreasury', 'archSum', 'archCust', 'archMeta']);
    }
  }
}
